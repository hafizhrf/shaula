# ── Discord (Emilia — legacy in-process front-end) ───────────────────────────
DISCORD_TOKEN=your_emilia_bot_token_here
DISCORD_GUILD_ID=123456789012345678

# Emilia's brain+body migrated to the standalone hermes-agent gateway, which now
# owns DISCORD_TOKEN. Keep false so the in-process Emilia client does NOT connect
# (avoids a Discord token collision). true = legacy in-process behavior.
EMILIA_ENABLED=false

# Role IDs (Discord snowflake IDs — right-click role → Copy Role ID). 0 = unset.
DEVOPS_ROLE_ID=0
ADMIN_ROLE_ID=0

# Channel for restart down/up status notices. 0 = auto (guild system channel).
STATUS_CHANNEL_ID=0

# ── Shaula bot (Claude Code executor — separate Discord app) ─────────────────
# Blank token = Shaula disabled. APP_ID/PUBLIC_KEY are used for slash-command
# registration / interaction verification tooling.
SHAULA_DISCORD_TOKEN=your_shaula_bot_token_here
SHAULA_APP_ID=123456789012345678
SHAULA_PUBLIC_KEY=your_shaula_public_key_here

# ── Anthropic / Claude Code ──────────────────────────────────────────────────
# Empty = use `claude login` OAuth (Pro subscription). Set sk-ant-... for API key.
ANTHROPIC_API_KEY=
CLAUDE_BIN=/usr/bin/claude
# Model for Claude Code tasks. Empty = account default (no --model flag). e.g. "sonnet".
CLAUDE_MODEL=
# Config dir for the "kantor" (work-profile) account used by /task-kantor as a
# fallback when the default account hits its 5-hour limit. Empty = ~/.claude-kantor.
CLAUDE_KANTOR_CONFIG_DIR=
# 0 = no per-task budget cap (default). Set e.g. 0.50 to cap cost per task.
CLAUDE_MAX_BUDGET_USD=0
# Auto-/compact a session when its context-window size reaches this many tokens. 0 = off.
CLAUDE_COMPACT_THRESHOLD_TOKENS=150000
# Auto-close a persistent Claude session after this many seconds idle (1800 = 30 min).
CLAUDE_SESSION_IDLE_SECONDS=1800

# ── Bot behavior ─────────────────────────────────────────────────────────────
PROJECTS_BASE_DIR=/opt/agent/projects
# Persistent run-history SQLite DB. Empty = <bot dir>/data/runs.db.
RUN_DB_PATH=
APPROVAL_TIMEOUT_SECONDS=900
STREAM_EDIT_INTERVAL_SECONDS=1.5
# Execution watchdog. A task is killed only after this many seconds with NO new
# output (genuinely hung), not by total runtime — long-but-active tasks keep going.
EXEC_IDLE_TIMEOUT_SECONDS=600
# Absolute safety ceiling on total task runtime (seconds).
EXEC_MAX_TIMEOUT_SECONDS=5400
LOG_LEVEL=INFO

# ── Ollama local LLM (intent routing) ────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hermes3:3b
# How long Ollama keeps the model resident after a request. "-1" = forever.
OLLAMA_KEEP_ALIVE=10m

# ── Dify knowledge base (RAG) ────────────────────────────────────────────────
# Blank dataset id/key = feature off (graceful no-op).
DIFY_BASE_URL=http://127.0.0.1:5001
DIFY_DATASET_ID=
DIFY_DATASET_API_KEY=

# ── Cloudflare DNS automation (used by /opt/agent/bin/cf-dns) ────────────────
# Token needs Zone:DNS:Edit on the zone. Create at:
#   https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=
CF_DOMAIN=hafizhrf.me
CF_ZONE_ID=
CF_PROXY=true
VPS_PUBLIC_IP=43.156.137.192

# ── Delegation intake (external Emilia gateway -> Shaula task) ────────────────
# Localhost-only HTTP endpoint. Token is a shared secret with ~/.hermes/.env.
DELEGATE_INTAKE_PORT=8765
DELEGATE_INTAKE_TOKEN=
